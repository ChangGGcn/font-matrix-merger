# === Python ===
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# === PyInstaller build outputs ===
# 注意：build/build_exe.py 和 build/merge_fonts.spec 是源码，需要提交；
# 这里只忽略 PyInstaller 生成的输出子目录（如 build/merge_fonts/）
build/*/
*.manifest
*.toc

# === 本地授权测试字体与生成样品：绝不提交 ===
# 本地测试字体（含商用授权字体）不随仓库分发；真实路径见 tests/local_fonts.py
test/fonts/
test/samples/
samples/
render_out/
matrix_out/

# === 字体二进制：一律不入库 (仓库只放源码；release 资产另行打包) ===
# 部分测试字体是商用授权/体积很大, 误提交代价高, 这里按扩展名全拦
*.ttf
*.otf
*.ttc
*.otc
*.woff
*.woff2
*.eot
*.dfont
*.pfb
*.pfa
*.pfr
*.bdf
*.pcf
# fontTools TTX 中间产物 (体积大且可再生)
*.ttx

# 本地字体路径配置（含商业授权字体文件名，不入库）
tests/local_fonts.py

# === 编辑器 / 操作系统 ===
.idea/
.vscode/
*.swp
*.swo
Thumbs.db
Desktop.ini
.DS_Store

